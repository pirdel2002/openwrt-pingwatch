#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

start_service() {
    mkdir -p /tmp/pingwatch
    procd_open_instance
    procd_set_param command /bin/sh /usr/sbin/pingwatch
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger pingwatch
}

reload_service() {
    stop
    start
}
