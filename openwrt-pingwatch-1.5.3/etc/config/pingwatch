config main 'main'
	option led_enabled '0'
	option ok_led_color '#00ff00'
        option loop_sleep '3'

config internet 'internet'
	option enabled '0'

config sms 'sms'
        option enabled '0'
        option provider 'ippanel'
        option api_key ''
        option from_number ''
        option recipients ''
        option timeout '12'

config target 'google_dns'
	option led_enabled '1'
	option led_color '#ff0000'
        option enabled '1'
        option name 'Google DNS'
        option host '8.8.8.8'
        option interval '15'
        option timeout '2'
        option count '1'
        option fail_threshold '3'
        option recover_threshold '2'

	option notify_mode 'both'
config target 'torob'
	option led_enabled '1'
	option led_color '#ff0000'
        option enabled '1'
        option name 'Torob'
        option host 'torob.com'
        option interval '30'
        option timeout '2'
        option count '1'
        option fail_threshold '3'
        option recover_threshold '2'

	option notify_mode 'both'
config target 'google'
	option led_enabled '1'
	option led_color '#ff0000'
        option enabled '1'
        option name 'Google'
        option host 'google.com'
        option interval '30'
        option timeout '2'
        option count '1'
        option fail_threshold '3'
        option recover_threshold '2'
	option notify_mode 'both'
