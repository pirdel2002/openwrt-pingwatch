#!/usr/bin/lua
local nx=require('nixio')
local fs=require('nixio.fs')
local json=require('luci.jsonc')
local sys=require('luci.sys')
local policy=dofile('/usr/share/pingwatch-manager/policy.lua')
local diagnostics=dofile('/usr/share/pingwatch-manager/diagnostics.lua')
local direct=dofile('/usr/share/pingwatch-manager/direct.lua')
local wan_dns=dofile('/usr/share/pingwatch-manager/dns.lua')
local stability=dofile('/usr/share/pingwatch-manager/stability.lua')
local check_only=arg[1]=='--check-configs'
local direct_only=arg[1]=='--check-direct'
local target=arg[1]=='--check-node' and arg[2] or nil
assert(not arg[1] or check_only or direct_only or target,'unknown_argument')
assert(not target or target:match('^[%w_]+$'),'invalid_node')
local base='/tmp/pingwatch-manager'
local result_name=target and 'candidate-check' or direct_only and 'direct-checks' or check_only and 'config-checks' or 'results'
local work=base..'/work'
local child
local function quote(s) return "'"..s:gsub("'", "'\\''").."'" end
local function stop()
  if child then nx.kill(child,15); nx.waitpid(child); child=nil end
end
local function clean()
  stop()
  for _,f in ipairs({'core.json','core.err','probe.txt','dns.txt','adapter.err','legacy.rules','config/passwall2','cache/cache_pingwatch_test.txt'}) do fs.unlink(work..'/'..f) end
  fs.rmdir(work..'/cache'); fs.rmdir(work..'/config'); fs.rmdir(work); fs.rmdir(base..'/lock')
end
nx.umask('0077')
fs.mkdir(base,'0700')
assert(not fs.lstat(base..'/apply.lock') or target or direct_only,'apply_in_progress')
assert(not fs.lstat(base..'/lock'), 'worker_already_running')
assert(fs.mkdir(base..'/lock','0700'), 'worker_already_running')
local function publish(s)
  assert(fs.writefile(base..'/'..result_name..'.new',json.stringify(s)))
  assert(fs.rename(base..'/'..result_name..'.new',base..'/'..result_name..'.json'))
end
local function direct_test()
  local function evidence()
    local raw=sys.exec('timeout 5 nft -s -j list ruleset 2>/dev/null')
    local verified,why,proof=direct.firewall(direct.decode(raw,json.parse))
    if not verified then return nil,'firewall_'..(why or 'bypass_unverified') end
    local legacy
    if sys.call('command -v iptables-legacy-save >/dev/null 2>&1')==0 then legacy='iptables-legacy-save'
    elseif sys.call('command -v iptables-save >/dev/null 2>&1')==0 and
      not (sys.exec('iptables-save --version 2>/dev/null') or ''):find('nf_tables',1,true) then legacy='iptables-save' end
    if legacy then
      if sys.call('timeout 5 '..legacy..' > '..quote(work..'/legacy.rules')..' 2>/dev/null')~=0 or
        (fs.readfile(work..'/legacy.rules') or ''):find('%-A%s') then return nil,'legacy_firewall_unverified' end
    end
    local status=json.parse(sys.exec('timeout 5 ubus call network.interface.wan status 2>/dev/null') or '')
    local proto=require('luci.model.uci').cursor():get('network','wan','proto')
    local dev=direct.wan(status,proto)
    if not dev then return nil,'wan_unverified' end
    local servers,routes={},{}
    for _,server in ipairs(wan_dns.servers(status)) do
      local route=sys.exec('timeout 5 ip -4 route get '..server..' 2>/dev/null') or ''
      local route_proof=direct.route(route,dev)
      if route_proof then servers[#servers+1]=server; routes[#routes+1]=server..'='..route_proof end
    end
    if #servers==0 then return nil,'wan_dns_route_unverified' end
    return {rules=proof,device=dev,proto=proto,servers=servers,route=table.concat(routes,';')}
  end
  local before,reason=evidence()
  if not before then return {state='unverified',path_verified=false,reason=reason} end
  local function run_child(output_file,args)
    child=assert(nx.fork())
    if child==0 then
      local output=assert(nx.open(output_file,'w','0600'))
      local null=assert(nx.open('/dev/null','w')); nx.dup(output,nx.stdout); nx.dup(null,nx.stderr)
      for _,name in ipairs({'http_proxy','https_proxy','all_proxy','HTTP_PROXY','HTTPS_PROXY','ALL_PROXY'}) do nx.setenv(name) end
      if not nx.setgid(9912) then os.exit(126) end
      nx.exec('/usr/bin/timeout','-k','2','10',unpack(args)); os.exit(127)
    end
    local _,status,rc=nx.waitpid(child); child=nil
    return status,rc
  end
  local probes={}
  for i,host in ipairs({'www.google.com','cp.cloudflare.com'}) do
    local resolved,dns_rc,attempts
    for n,server in ipairs(before.servers) do
      local status,rc=run_child(work..'/dns.txt',{'/bin/busybox','nslookup','-type=A',host,server})
      dns_rc=rc; attempts=n
      local answers=wan_dns.answers(fs.readfile(work..'/dns.txt'))
      fs.unlink(work..'/dns.txt')
      if status=='exited' and rc==0 and #answers>0 then resolved=answers[1]; break end
    end
    if not resolved then
      probes[#probes+1]={endpoint=i,ok=false,http_code=0,exit_code=dns_rc,dns_source='wan',dns_resolved=false,
        dns_attempts=attempts,failure='dns_resolution_failed'}
    else
    local status,rc=run_child(work..'/probe.txt',{'/usr/bin/curl','--disable','--silent','--ipv4','--proxy','','--noproxy','*',
      '--interface','if!'..before.device,'--resolve',host..':443:'..resolved,
      '--connect-timeout','4','--max-time','7','--output','/dev/null','--write-out',
      '%{http_code}:%{time_total}:%{time_namelookup}:%{time_connect}:%{time_appconnect}',
      'https://'..host..'/generate_204'})
    local code,t,dns,connect,tls=(fs.readfile(work..'/probe.txt') or ''):match('^(%d%d%d):([%d.]+):([%d.]+):([%d.]+):([%d.]+)$')
    dns,connect,tls=tonumber(dns),tonumber(connect),tonumber(tls)
    local failure=rc==0 and code=='204' and 'none' or
      rc==28 and connect==0 and 'connect_timeout' or rc==28 and tls==0 and 'tls_timeout' or
      rc==28 and 'request_timeout' or (rc==35 or rc==60) and 'tls_error' or 'request_failed'
    probes[#probes+1]={endpoint=i,ok=status=='exited' and rc==0 and code=='204',http_code=tonumber(code),exit_code=rc,
      failure=failure,dns_source='wan',dns_resolved=true,dns_attempts=attempts,connect_ms=connect and math.floor(connect*1000),
      tls_ms=tls and math.floor(tls*1000),ms=tonumber(t) and math.floor(tonumber(t)*1000)}
    fs.unlink(work..'/probe.txt')
    end
  end
  local after,post_reason=evidence()
  local changed=not after and 'postcheck_'..(post_reason or 'failed') or
    after.rules~=before.rules and 'firewall_path_changed' or
    (after.device~=before.device or after.proto~=before.proto) and 'wan_path_changed' or
    after.route~=before.route and 'wan_route_changed'
  if changed then
    return {state='unverified',path_verified=false,reason=changed,probes=probes}
  end
  -- Unsupported curl features/setup failures are unknown, not WAN failure.
  for _,p in ipairs(probes) do if p.exit_code==2 or p.exit_code==4 or p.exit_code==126 or p.exit_code==127 then
    return {state='unverified',path_verified=false,reason='direct_probe_unavailable',probes=probes} end end
  return {state=probes[1].ok and probes[2].ok and 'healthy' or 'unhealthy',path_verified=true,
    method='wan_bound_gid9912_https_wan_dns',probes=probes}
end
local ok=pcall(function()
  assert(fs.mkdir(work,'0700')); assert(fs.mkdir(work..'/config','0700'))
  assert(fs.mkdir(work..'/cache','0700'))
  local snapshot=assert(fs.readfile('/etc/config/passwall2'))
  assert(fs.writefile(work..'/config/passwall2',snapshot))
  local cursor=require('luci.model.uci').cursor(work..'/config')
  local nodes,subs=policy.inventory(cursor)
  local report={phase=1,mode=target and 'candidate_check_only' or direct_only and 'direct_check_only' or check_only and 'config_check_only' or 'observe_only',started_at=os.time(),running=true,rows={},subscriptions=subs,
    guard_ok=policy.guard(cursor),direct={state='unverified'},route_changed=false}
  publish(report)
  local selected={}
  for _,n in ipairs(nodes) do if not target or n.id==target then selected[#selected+1]=n end end
  for _,n in ipairs(direct_only and {} or selected) do
    local row={id=n.id,protocol=n.protocol,core=n.core,state='unsupported'}
    if n.id:match('^[%w_]+$') and (n.core=='Xray' or n.core=='Sing-Box' or n.core=='sing-box') then
      -- Reserve a currently free loopback port; core readiness is checked below.
      local sock=assert(nx.socket('inet','stream'))
      assert(sock:bind('127.0.0.1',0)); local _,port=sock:getsockname(); sock:close()
      local cmd='timeout 15 lua /usr/share/pingwatch-manager/generate.lua '..quote(work..'/config')..' '..quote(n.id)..' '..port..' > '..quote(work..'/core.json')..' 2> '..quote(work..'/adapter.err')
      local adapter_rc=sys.call(cmd)
      if adapter_rc==0 then
        local binary=n.core=='Xray' and '/usr/bin/xray' or '/usr/bin/sing-box'
        local check=n.core=='Xray' and 'run -test -c' or 'check -c'
        local check_rc=sys.call('timeout 10 '..binary..' '..check..' '..quote(work..'/core.json')..' > '..quote(work..'/core.err')..' 2>&1')
        if check_rc==0 and check_only then
          row.state='config_valid'
        elseif check_rc==0 then
          child=assert(nx.fork())
          if child==0 then
            local null=assert(nx.open('/dev/null','w')); nx.dup(null,nx.stdout); nx.dup(null,nx.stderr)
            nx.exec('/usr/bin/timeout','-k','2','25',binary,'run','-c',work..'/core.json'); os.exit(127)
          end
          local ready=false
          for _=1,30 do
            local s=nx.socket('inet','stream'); ready=s:connect('127.0.0.1',port); s:close()
            if ready then break end; nx.nanosleep(0,100000000)
          end
          if ready then
            local probes={}
            for _,url in ipairs({'https://www.google.com/generate_204','https://cp.cloudflare.com/generate_204'}) do
              local rc=sys.call("env -u ALL_PROXY -u HTTPS_PROXY -u HTTP_PROXY curl --disable --silent --show-error --noproxy '' --proxy socks5h://127.0.0.1:"..port.." --connect-timeout 4 --max-time 7 --output /dev/null --write-out '%{http_code}:%{time_total}' "..quote(url)..' > '..quote(work..'/probe.txt')..' 2>/dev/null')
              local code,t=(fs.readfile(work..'/probe.txt') or ''):match('^(%d%d%d):([%d.]+)$')
              local failure=rc==0 and code=='204' and 'none' or rc==0 and 'http_status' or rc==28 and 'timeout' or
                (rc==35 or rc==60) and 'tls_error' or rc==5 and 'proxy_dns_error' or rc==6 and 'dns_error' or
                rc==7 and 'connect_error' or 'request_failed'
              probes[#probes+1]={endpoint=#probes+1,ok=rc==0 and code=='204',http_code=tonumber(code),exit_code=rc,
                failure=failure,ms=tonumber(t) and math.floor(tonumber(t)*1000)}
            end
            row.state=probes[1].ok and probes[2].ok and 'healthy' or 'unhealthy'
            row.probes=probes
            if row.state=='healthy' then row.latency_ms=math.max(probes[1].ms,probes[2].ms) end
          else row.state='error'; row.reason='core_not_ready' end
          stop()
        else
          row.state='error'; row.reason='core_config_invalid'
          row.diagnostic={code=diagnostics.classify(fs.readfile(work..'/core.err'),check_rc),exit_code=check_rc,
            shape=diagnostics.shape(json.parse(fs.readfile(work..'/core.json') or '') or {},n.core)}
        end
      else
        local stage,source,line=(fs.readfile(work..'/adapter.err') or ''):match('PWDIAG:([%w_]+):([%w_.%-]+):(%d+)')
        row.reason='adapter_failed'; row.adapter_exit=adapter_rc
        if stage then row.diagnostic={stage=stage,source=source,line=tonumber(line)} end
        row.state=stage and stage:match('^guard_') and 'unsupported' or 'error'
      end
    end
    fs.unlink(work..'/core.json'); fs.unlink(work..'/probe.txt'); fs.unlink(work..'/adapter.err')
    fs.unlink(work..'/core.err')
    fs.unlink(work..'/cache/cache_pingwatch_test.txt')
    report.rows[#report.rows+1]=row; publish(report)
  end
  if not check_only and not target then
    local tested,result=pcall(direct_test)
    report.direct=tested and result or {state='unverified',path_verified=false,reason='direct_probe_error'}
    stop()
  end
  local unchanged=fs.readfile('/etc/config/passwall2')==snapshot
  report.running=false; report.finished_at=os.time(); report.snapshot_current=unchanged
  report.recommendation=direct_only and {state='unknown',reason='direct_check_only'} or
    policy.recommend(report.rows,report.guard_ok and unchanged,report.direct.state=='healthy' and report.direct.path_verified==true)
  report.complete=unchanged
  if not check_only and not direct_only and not target then
    local context
    if type(sys.exec)=='function' then context=(sys.exec('sha256sum '..quote(work..'/config/passwall2')..' 2>/dev/null') or ''):match('^(%x+)') end
    local old=json.parse(fs.readfile(base..'/history.json') or '')
    local history
    history,report.stability=stability.update(old,report,context)
    assert(fs.writefile(base..'/history.new',json.stringify(history)))
    assert(fs.rename(base..'/history.new',base..'/history.json'))
    report.plan=policy.plan(report,cursor,os.time())
  end
  publish(report)
end)
clean()
if not ok then
  publish({phase=1,mode='observe_only',running=false,complete=false,error='worker_failed',route_changed=false,rows={}})
  os.exit(1)
end
